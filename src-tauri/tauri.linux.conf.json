{
  "productName": "floral-notepaper",
  "identifier": "com.floral-notepaper.app",
  "build": {
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "花笺",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "linux": {
      "deb": {
        "depends": [],
        "section": "utils",
        "priority": "optional",
        "desktopTemplate": "linux-desktop-template.hbs"
      },
      "rpm": {
        "epoch": 0,
        "release": "1",
        "depends": ["webkit2gtk4.1", "gtk3", "librsvg2"],
        "desktopTemplate": "linux-desktop-template.hbs"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
